table _Medidas
	lineageTag: 35802db6-655e-4181-9a5a-2440df643336

	/// Solicitacoes criadas no periodo; desconsidera propostas duplicadas ou demandas criadas incorretamente.
	measure 'Solicitações recebidas' =
			COALESCE(
			    CALCULATE(
			        DISTINCTCOUNT('Proposals'[WorkItemId]),
			        'Proposals'[WorkItemType] = "Proposal",
			        KEEPFILTERS(
			            NOT (
			                'Proposals'[ReasonforDiscarded] IN {
			                    "Duplicate Proposal",
			                    "Incorrect Demand Creation"
			                }
			            )
			        )
			    ),
			    0
			)
		formatString: #,0
		displayFolder: Visão Geral
		lineageTag: b527080e-61da-4335-a707-77cb776fa7e7

	/// Primeira entrada da proposta em Approval no intervalo do calendario.
	measure 'Propostas submetidas' =
			VAR DatasSelecionadas = VALUES('Calendario'[Date])
			RETURN
			    COALESCE(
			        CALCULATE(
			            COUNTROWS(
			                FILTER(
			                    SUMMARIZE(
			                        FILTER(
			                            'ProposalStateHistory',
			                            'ProposalStateHistory'[State] = "Approval"
			                        ),
			                        'ProposalStateHistory'[WorkItemId],
			                        "@PrimeiraEntrada",
			                        MIN('ProposalStateHistory'[DataEntrada])
			                    ),
			                    NOT ISBLANK([@PrimeiraEntrada])
			                        && CONTAINS(
			                            DatasSelecionadas,
			                            'Calendario'[Date],
			                            INT([@PrimeiraEntrada])
			                        )
			                )
			            ),
			            CROSSFILTER(
			                'Proposals'[CreatedDate],
			                'Calendario'[Date],
			                NONE
			            )
			        ),
			        0
			    )
		formatString: #,0
		displayFolder: Visão Geral
		lineageTag: d30cc91f-0017-4f1c-a833-db9f774f3664

	/// Closed e Discarded igual a FALSE, considerando ClosedDate.
	measure 'Propostas aceitas' =
			COALESCE(
			    CALCULATE(
			        DISTINCTCOUNT('Proposals'[WorkItemId]),
			        'Proposals'[State] = "Closed",
			        'Proposals'[Discarded] == FALSE(),
			        NOT ISBLANK('Proposals'[ClosedDate]),
			        CROSSFILTER(
			            'Proposals'[CreatedDate],
			            'Calendario'[Date],
			            NONE
			        ),
			        USERELATIONSHIP(
			            'Proposals'[ClosedDate],
			            'Calendario'[Date]
			        )
			    ),
			    0
			)
		formatString: #,0
		displayFolder: Visão Geral
		lineageTag: 05c5969d-5843-46fc-a2da-ad2712e5be6a

	/// Closed, Discarded=TRUE e ClosedDate no periodo; nao conta duplicidades, criacoes indevidas nem transferencias ao suporte.
	measure 'Propostas recusadas' =
			COALESCE(
			    CALCULATE(
			        DISTINCTCOUNT('Proposals'[WorkItemId]),
			        'Proposals'[State] = "Closed",
			        'Proposals'[Discarded] == TRUE(),
			        NOT ISBLANK('Proposals'[ClosedDate]),
			        KEEPFILTERS(
			            NOT (
			                'Proposals'[ReasonforDiscarded] IN {
			                    "Duplicate Proposal",
			                    "Incorrect Demand Creation",
			                    "Transferred to Support Team"
			                }
			            )
			        ),
			        CROSSFILTER(
			            'Proposals'[CreatedDate],
			            'Calendario'[Date],
			            NONE
			        ),
			        USERELATIONSHIP(
			            'Proposals'[ClosedDate],
			            'Calendario'[Date]
			        )
			    ),
			    0
			)
		formatString: #,0
		displayFolder: Visão Geral
		lineageTag: f802f2ef-014d-4a36-97dc-494a8d4a5688

	/// Denominador da taxa de aceite.
	measure 'Decisões comerciais' = [Propostas aceitas] + [Propostas recusadas]
		formatString: #,0
		displayFolder: Visão Geral
		lineageTag: 40caa719-caf5-4210-9d38-8df7907461f2

	/// Aceitas divididas pelas decisoes comerciais. Em branco sem decisoes.
	measure 'Taxa de aceite' =
			DIVIDE(
			    [Propostas aceitas],
			    [Decisões comerciais]
			)
		formatString: 0.0%
		displayFolder: Visão Geral
		lineageTag: 58d4f126-1a12-44d9-8b10-eea972405f01

	/// Closed e Discarded vazio, independentemente do periodo.
	measure 'Validação - fechadas sem classificação' =
			COALESCE(
			    CALCULATE(
			        DISTINCTCOUNT('Proposals'[WorkItemId]),
			        'Proposals'[State] = "Closed",
			        ISBLANK('Proposals'[Discarded]),
			        REMOVEFILTERS('Calendario')
			    ),
			    0
			)
		formatString: #,0
		displayFolder: Validação
		lineageTag: 3d2b5f97-b586-4a76-9d9b-ec0255ae0d5f

	/// Closed e ClosedDate vazio, independentemente do periodo.
	measure 'Validação - fechadas sem data' =
			COALESCE(
			    CALCULATE(
			        DISTINCTCOUNT('Proposals'[WorkItemId]),
			        'Proposals'[State] = "Closed",
			        ISBLANK('Proposals'[ClosedDate]),
			        REMOVEFILTERS('Calendario')
			    ),
			    0
			)
		formatString: #,0
		displayFolder: Validação
		lineageTag: fc048e7b-b3eb-4a4b-8e37-790061f0e55e

	/// Contagem historica das solicitacoes administrativas removidas de Recebidas.
	measure 'Validação - solicitações administrativas' =
			COALESCE(
			    CALCULATE(
			        DISTINCTCOUNT('Proposals'[WorkItemId]),
			        'Proposals'[WorkItemType] = "Proposal",
			        'Proposals'[ReasonforDiscarded] IN {
			            "Duplicate Proposal",
			            "Incorrect Demand Creation"
			        },
			        REMOVEFILTERS('Calendario')
			    ),
			    0
			)
		formatString: #,0
		displayFolder: Validação

	/// Contagem historica dos encaminhamentos ao suporte, que nao sao recusas comerciais.
	measure 'Validação - transferidas ao suporte' =
			COALESCE(
			    CALCULATE(
			        DISTINCTCOUNT('Proposals'[WorkItemId]),
			        'Proposals'[State] = "Closed",
			        'Proposals'[Discarded] == TRUE(),
			        'Proposals'[ReasonforDiscarded] = "Transferred to Support Team",
			        REMOVEFILTERS('Calendario')
			    ),
			    0
			)
		formatString: #,0
		displayFolder: Validação

	/// Quantidade atual de propostas em States nao fechados; independe do periodo, mas respeita os demais filtros.
	measure 'Carteira atual' =
			COALESCE(
			    CALCULATE(
			        DISTINCTCOUNT('Proposals'[WorkItemId]),
			        KEEPFILTERS('Proposals'[WorkItemType] = "Proposal"),
			        KEEPFILTERS('Proposals'[State] <> "Closed"),
			        KEEPFILTERS(NOT ISBLANK('Proposals'[State])),
			        KEEPFILTERS(
			            NOT (
			                'Proposals'[ReasonforDiscarded] IN {
			                    "Duplicate Proposal",
			                    "Incorrect Demand Creation"
			                }
			            )
			        ),
			        REMOVEFILTERS('Calendario')
			    ),
			    0
			)
		formatString: #,0
		displayFolder: 'Visão Geral\Gráficos'

	/// Participacao do State na carteira aberta. Use como tooltip da carteira atual por State.
	measure 'Carteira atual (% por State)' =
			DIVIDE(
			    [Carteira atual],
			    CALCULATE(
			        [Carteira atual],
			        REMOVEFILTERS('Proposals'[State])
			    )
			)
		formatString: 0.0%
		displayFolder: 'Visão Geral\Gráficos'

	/// Percentual de recusas dentre as decisoes comerciais; pode ser exibido no tooltip por responsavel.
	measure 'Taxa de recusa' =
			DIVIDE(
			    [Propostas recusadas],
			    [Decisões comerciais]
			)
		formatString: 0.0%
		displayFolder: 'Visão Geral\Gráficos'

	/// Recusas comerciais com ReasonforDiscarded preenchido (sem nulos, vazios ou so espacos).
	/// As exclusoes administrativas e o periodo de fechamento ja estao na medida base Propostas recusadas.
	measure 'Recusas com motivo informado' =
			CALCULATE(
			    [Propostas recusadas],
			    KEEPFILTERS(
			        FILTER(
			            VALUES('Proposals'[ReasonforDiscarded]),
			            LEN(TRIM('Proposals'[ReasonforDiscarded] & "")) > 0
			        )
			    )
			)
		formatString: #,0
		displayFolder: 'Visão Geral\Gráficos'

	/// Recusas comerciais sem motivo informado no contexto atual; nao devem aparecer no grafico de motivos.
	measure 'Validação - recusas sem motivo' =
			COALESCE(
			    CALCULATE(
			        [Propostas recusadas],
			        KEEPFILTERS(
			            FILTER(
			                VALUES('Proposals'[ReasonforDiscarded]),
			                LEN(TRIM('Proposals'[ReasonforDiscarded] & "")) = 0
			            )
			        )
			    ),
			    0
			)
		formatString: #,0
		displayFolder: Validação

	column Placeholder
		dataType: string
		isHidden
		lineageTag: 4ca94cc2-280c-4bbf-b2f8-af4505874d80
		summarizeBy: none
		sourceColumn: [Placeholder]

		annotation SummarizationSetBy = User

	partition _Medidas = calculated
		mode: import
		source = DATATABLE("Placeholder", STRING, {{""}})

